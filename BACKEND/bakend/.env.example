# Copiar a .env y completar con los valores reales. Nunca commitear el .env real.

SPRING_PROFILES_ACTIVE=prod

# Conexión a Supabase Postgres. sslmode=require es obligatorio.
# Directa (una sola instancia del backend):
#   jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Vía connection pooler Supavisor (si hay más de una instancia del backend en paralelo):
#   jdbc:postgresql://<project-ref>.pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Conservador; ajustar según el límite de conexiones concurrentes del plan de Supabase.
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=2

# JWT: secreto de al menos 32 caracteres (HS256).
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Dominio real donde se sirve el frontend en producción (sin barra final).
CORS_ALLOWED_ORIGINS=https://app.auditoriasindustriales.com

# Supabase Storage
SUPABASE_STORAGE_URL=https://<project-ref>.supabase.co/storage/v1
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET_REPORTES=reportes
SUPABASE_BUCKET_EVIDENCIA=evidencia
